;
; scsichk.inf
;
; Installation inf for the Disk Performance Monitor Filter driver [ DDK Sample ]
;
; Copyright (c) Microsoft Corporation
;

[Version]
Signature = "$Windows NT$"
Class     = DiskDrive
ClassGUID = {4d36e967-e325-11ce-bfc1-08002be10318}
Provider  = %ltrdata%
DriverVer = 03/22/2002,5.1.2600.0
CatalogFile=scsichk.cat

;
; General installation section
;

[DefaultInstall.NT]
CopyFiles = @scsichk.sys
Addreg    = scsichk.AddReg

[DestinationDirs]
DefaultDestDir = 12

[scsichk.AddReg]
; UpperFilters for DiskDrive class
;; HKLM, System\CurrentControlSet\Control\Class\{4d36e967-e325-11ce-bfc1-08002be10318}, UpperFilters, 0x00010008, scsichk

; LowerFilters for CDROM class
HKLM, System\CurrentControlSet\Control\Class\{4d36e965-e325-11ce-bfc1-08002be10318}, LowerFilters, 0x00010008, scsichk


;
; Service installation section
;

[DefaultInstall.NT.Services]
AddService = scsichk, , scsichk.Service.Install

[scsichk.Service.Install]
DisplayName    = %service_desc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1
ServiceBinary  = %12%\scsichk.sys
LoadOrderGroup = "PnP Filter"

[SourceDisksFiles]
scsichk.sys=1

[SourceDisksNames]
1 = %diskid1%,,,

;
; Localizable Strings
;

[Strings]

ltrdata      = "LTR Data"
service_desc = "SCSI Meta Command Logger Filter Driver"
diskid1      = "Installation Disk #1 (ScsiChk)"
